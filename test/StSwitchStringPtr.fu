public static class Test
{
	public static bool Run()
	{
		string[1] s;
		s[0] = "bar";
		int i = 0;
		switch (s[i++]) {
		case "foo":
		case "quux":
			return false;
		case "bar":
			if (s[0][0] == 'b')
				break;
			return false;
		default:
			return false;
		}

		for (i = 0; i < 3; i++) {
			switch (s[0]) {
			case "bar":
				if (s[0][0] == 'X')
					break;
				continue;
			default:
				return false;
			}
			return false;
		}

		return i == 3;
	}
}
